{
  "name": "creative-workstation",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "description": "Local-first, plugin-composed AI creative workstation",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "build:core": "cargo build -p workstation-core",
    "build:media": "node scripts/build-media.mjs",
    "setup:media": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-media.ps1",
    "build": "node scripts/build-moy-editor.mjs && npm run typecheck && vite build && npm run build:core",
    "typecheck": "tsc --noEmit",
    "test:core": "cargo test -p workstation-core",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:core && npm run test:unit",
    "mcp": "node scripts/mcp.mjs",
    "probe:media": "node scripts/probe-media.mjs",
    "format": "prettier --write src packages electron scripts tests *.ts *.json && cargo fmt --all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "~7.3.6",
    "vitest": "^3.2.4"
  }
}
